{
  "schemaVersion": 1,
  "id": "tsclient",
  "version": "${version}",
  "name": "FuschenAddons",
  "description": "Client-side fishing helper and SkyBlock utilities.",
  "icon": "icon.png",
  "authors": ["you"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "mixins": [{ "config": "fuschenaddons.client.mixins.json", "environment": "client" }],
  "entrypoints": {
    "client": ["com.FishHelper.FishHelperClient"]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=25",
    "fabric-api": ">=${fabricApiVersion}",
    "cascade": ">=2026.9.7",
    "fabric-language-kotlin": ">=${fabricKotlinVersion}"
  }
}
